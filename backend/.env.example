# BIS AI Copilot Environment Configuration

# Database
# For SQLite (default local zero-friction setup):
DATABASE_URL=sqlite:///./bis_copilot.db

# For Production PostgreSQL:
# DATABASE_URL=postgresql://bis_user:bis_password@localhost:5432/bis_copilot

# Local Ollama AI Engine (free, locally hosted)
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15.0

# Server Settings
DEBUG=false
API_PREFIX=/api
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
